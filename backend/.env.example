PORT=5000
# Server-controlled CBT duration in whole minutes (1-180; defaults to 30).
QUIZ_DURATION_MINUTES=30
MONGO_URI=mongodb://<username>:<password>@<host1>:<port>,<host2>:<port>,<host3>:<port>/<database>?ssl=true&replicaSet=<replicaSet>&authSource=admin&appName=<appName>
JWT_SECRET=your_jwt_secret_here
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
FRONTEND_URL=http://localhost:5173
# Configure a real email provider for production verification and account emails.
EMAIL_FROM=noreply@example.com
SENDGRID_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# TEMPORARY: Configure only for account recovery; remove from Render to disable the diagnostic endpoint.
ACCOUNT_DIAGNOSTIC_SECRET=
# Comma-separated exact trusted browser origins; do not use wildcard hosting domains.
FRONTEND_ORIGINS=
STORAGE_PROVIDER=object-storage
STORAGE_BUCKET=your-private-bucket
STORAGE_REGION=auto
# Optional for AWS S3; required by many S3-compatible providers.
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
QUESTION_EXTRACTION_MAX_IMAGES=8
QUESTION_EXTRACTION_MAX_IMAGE_BYTES=8388608
QUESTION_EXTRACTION_MAX_BATCH_BYTES=33554432
QUESTION_EXTRACTION_MAX_IMAGE_PIXELS=15000000
QUESTION_EXTRACTION_MAX_BATCH_PIXELS=40000000
QUESTION_EXTRACTION_DAILY_BATCH_LIMIT=10
OCR_PROVIDER=tesseract.js
# Optional local folder containing eng.traineddata.gz for offline Tesseract.js use.
TESSERACT_LANG_PATH=
# Optional writable private directory for Tesseract's trained-data cache.
TESSERACT_CACHE_PATH=
